# Copy this file to .env and replace every placeholder. Do not commit .env.

# PostgreSQL used by Docker Compose and the Spring Boot backend.
POSTGRES_DB=mailmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=jdbc:postgresql://localhost:5433/mailmind
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-the-same-database-password
PORT=8080
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free

# Google OAuth web-client credentials
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret

# Browser/backend connection. The VITE_ values are bundled into the frontend at build time.
VITE_API_BASE_URL=
VITE_BACKEND_URL=http://localhost:8080
VITE_DEV_PORT=3000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Daily brief schedule (Quartz cron: second minute hour day-of-month month day-of-week)
DIGEST_CRON=0 0 8 * * ?
